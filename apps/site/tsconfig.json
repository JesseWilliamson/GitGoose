{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // dsviz is not on npm yet: Vite bundles it from the checkout beside this repository
    // (../DiagramBuilder, see vite.config.ts) and the types come from its build (`npm run build`
    // there), as they would from an npm install.
    "paths": { "@dsviz/*": ["../../../DiagramBuilder/packages/*/dist/index.d.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
