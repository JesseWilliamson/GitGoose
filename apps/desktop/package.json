{
  "name": "@gitgoose/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A fast git client with a clear commit graph",
  "author": "Jesse Williamson",
  "homepage": "https://github.com/JesseWilliamson/GitSquidElectron",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesseWilliamson/GitSquidElectron.git"
  },
  "desktopName": "gitgoose.desktop",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && node scripts/grammars.mjs && electron-builder"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "@anthropic-ai/sdk": "^0.135.0",
    "@parcel/watcher": "^2.6.0",
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "electron-updater": "^6.8.9",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@gitgoose/codegraph": "workspace:*",
    "@gitgoose/fixtures": "workspace:*",
    "@gitgoose/git": "workspace:*",
    "@gitgoose/graph": "workspace:*",
    "@gitgoose/shared": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
