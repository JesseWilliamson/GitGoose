{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src", "src/preload/types.d.ts"],
  // These run real git through @gitgoose/fixtures (Node), or read a file (hint.test.ts), so tsconfig.node.json checks them.
  "exclude": ["src/renderer/src/lib/lineView.test.ts", "src/renderer/src/lib/store.test.ts", "src/renderer/src/lib/hint.test.ts"]
}
